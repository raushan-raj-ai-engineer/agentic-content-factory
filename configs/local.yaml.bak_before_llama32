llm:
  provider: ollama
  model: qwen3:8b
  base_url: http://localhost:11434
  timeout: 600

research:
  provider: youtube_local
  mode: auto            # auto | topic
  topic: null
  category: technical   # technical | ai | software_testing | funny | entertainment | general | auto
  lookback_days: 7
  youtube:
    max_results: 20
    timeout: 30

human_approval:
  default:
    mode: auto           # auto | manual | skip
    response: "y"       # used only when mode=auto

content:
  default_duration_minutes: 8
  max_duration_minutes: 15
