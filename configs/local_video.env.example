# Own/local video engine V19. Copy only the values you want into your shell or project .env manually.
# The installer NEVER overwrites the project's .env.
CONTENT_FACTORY_MOTION_BACKEND=ltx
CONTENT_FACTORY_VOICE_BACKEND=piper
CONTENT_FACTORY_LIPSYNC_BACKEND=auto
CONTENT_FACTORY_VIDEO_WIDTH=512
CONTENT_FACTORY_VIDEO_HEIGHT=288
CONTENT_FACTORY_VIDEO_FPS=16
CONTENT_FACTORY_MAX_SHOT_SECONDS=4.0
LTX_VIDEO_PIPELINE_CONFIG=configs/ltxv-2b-0.9.8-distilled.yaml
# CONTENT_FACTORY_VIDEO_ENGINE_HOME=/Users/you/.cache/content-factory-video
