# ================================================================
# LLM: ONE PROVIDER + ONE MODEL PER RUN
# ================================================================
# auto | ollama | gemini | openai | anthropic | compatible
LLM_PROVIDER=auto

# auto mode tries configured cloud providers first and keeps Ollama as the local fallback.
# This fallback happens ONLY before the workflow starts. After [LLM LOCK],
# every agent uses the same provider and model for the complete run.
LLM_FALLBACK_ORDER=gemini,openai,anthropic,compatible,ollama
# If an explicitly selected cloud provider cannot start, use local Ollama.
# The fallback always discovers an installed model automatically.
LLM_OLLAMA_FALLBACK=true
LLM_TIMEOUT=180
LLM_HTTP_RETRIES=3
# Optional provider-specific retry overrides:
# GEMINI_HTTP_RETRIES=4
# GEMINI_MIN_REQUEST_INTERVAL_SECONDS=2.0  # increase to 4-6s on strict/free-tier RPM limits
# OPENAI_HTTP_RETRIES=3
# ANTHROPIC_HTTP_RETRIES=3
# LLM_COMPATIBLE_HTTP_RETRIES=3

# Backward-compatible generic override. Prefer provider-specific variables below.
LLM_MODEL=auto
LLM_API_KEY=

# ----------------------------------------------------------------
# Ollama (local, default first choice in auto mode)
# ----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=auto

# ----------------------------------------------------------------
# Google Gemini
# Set BOTH key and model before selecting Gemini or allowing auto to use it.
# ----------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# ----------------------------------------------------------------
# OpenAI
# Set BOTH key and model.
# ----------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# ----------------------------------------------------------------
# Anthropic
# Set BOTH key and model.
# ----------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# ----------------------------------------------------------------
# Any OpenAI-compatible provider (Groq/Together/DeepSeek/self-hosted/etc.)
# Base URL should point to the provider's OpenAI-compatible API root.
# API key may be blank for a local endpoint that does not require one.
# ----------------------------------------------------------------
LLM_COMPATIBLE_BASE_URL=
LLM_COMPATIBLE_API_KEY=
LLM_COMPATIBLE_MODEL=

# Existing research settings
YOUTUBE_API_KEY=
YOUTUBE_MAX_RESULTS=20
YOUTUBE_TIMEOUT=30

# Study Mode motion quality gate (0.35 = at least 35% of sampled frames must survive mpdecimate)
STUDY_ANIMATION_MIN_RETENTION=0.35

# ================================================================
# STUDY DURATION + LOCAL PREMIUM VOICE
# ================================================================
# Leave blank to follow the approved strategist duration. Set a positive number
# only when you want an explicit per-channel/default lesson target. CLI
# --duration-minutes overrides this value for a single run.
STUDY_DURATION_MINUTES=
# v0.5.5 voice pacing is automatically normalized per speaking style; no manual speed setting is required.

# auto prefers Kokoro for en-US when its local assets are installed, then
# falls back to Piper/macOS. Options: auto | kokoro | piper | macos
CONTENT_FACTORY_STUDY_VOICE_BACKEND=auto
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.fp16.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_VOICE_US_MALE=am_michael
KOKORO_VOICE_US_FEMALE=af_bella
# Keep character inserts in Kokoro instead of dropping to a macOS system voice.
KOKORO_CHARACTER_VOICES=am_fenrir,am_puck,af_bella,af_nicole
# Preserve natural prosody: do not force slow lines up by 18%.
CONTENT_FACTORY_VOICE_MAX_TEMPO=1.12
CONTENT_FACTORY_VOICE_MIN_TEMPO=0.90

# Final Study video narration mastering / QC
STUDY_AUDIO_MASTERING=1
STUDY_AUDIO_TARGET_LUFS=-16.0
STUDY_AUDIO_TRUE_PEAK_DBTP=-1.5
STUDY_AUDIO_LUFS_TOLERANCE=1.2

# Study visual readability / continuity QC (v0.5.8)
# Final MP4 sampling fails if too many near-empty/dim frames remain.
STUDY_MAX_EMPTY_FRAME_RATIO=0.03
STUDY_MIN_P10_OCCUPANCY=0.0075
STUDY_MIN_P25_OCCUPANCY=0.018
STUDY_MIN_FOREGROUND_LUMA=46

# Optional override for the dialogue-clarity chain applied before loudness normalization.
# Leave blank/unset to use the safe default: HPF + gentle 3.2 kHz presence + light compression.
# STUDY_AUDIO_CLARITY_FILTER=

# STUDY VISUALS — v0.6.2 U.S. active-learning precision-motion defaults
# Exact educational text/labels/code are rendered by Manim, never by diffusion.
CONTENT_FACTORY_STUDY_AI_HERO=0
# Up to 2 independent Manim scenes render in parallel on capable Macs.
CONTENT_FACTORY_STUDY_RENDER_PARALLEL=2

# v0.8 premium semantic-motion overrides. Keep these on auto to let the
# Visual Director choose per scene. Supported camera values:
# auto/static/guided/follow/focus/cinematic. Motion: auto/low/medium/high.
# Environment: auto/technical/data_space/code_lab/browser_space/document_space/
# analogy_warm/security_boundary/science_lab/clean_light.
STUDY_CAMERA_STYLE=auto
STUDY_MOTION_DENSITY=auto
STUDY_ENVIRONMENT=auto

# v1.1 beginner-first pedagogy. Each substantive chapter starts with a short
# WHAT IT MEANS scene, then a HOW IT FLOWS scene before examples/code/testing.
# Shorter narration windows prevent one composition from staying on screen for
# 25-30 seconds and improve voice-to-visual semantic alignment.
STUDY_BEGINNER_FIRST=true
STUDY_SCENE_MIN_WORDS=34
STUDY_SCENE_MAX_WORDS=48

# Primary study-video viewer market. US is the default for concise American-English
# labels and familiar left-to-right explanatory flow.
STUDY_VIEWER_MARKET=US
# Normal YouTube videos keep narration uninterrupted. Turn this on only for an
# explicitly interactive/course-style export. When enabled, checks are sparse.
STUDY_ACTIVE_CHECKS=false
STUDY_ACTIVE_CHECK_EVERY=4

# Runtime resilience for long Study Mode script generation
# Six smaller semantic chunks are used in Study Mode. These bounds prevent a
# slow local request from killing the full run; timed-out local models can
# switch once to another installed Ollama model before micro-rescue.
CONTENT_FACTORY_SCRIPT_CHUNK_TIMEOUT=150
CONTENT_FACTORY_SCRIPT_RESCUE_TIMEOUT=90
CONTENT_FACTORY_SCRIPT_MICRO_TIMEOUT=75
CONTENT_FACTORY_OLLAMA_NUM_PREDICT=2400
CONTENT_FACTORY_OLLAMA_FAILOVER_ORDER=llama3.2,qwen2.5:3b,qwen3:4b,qwen,llama

# v0.7 word timing: auto falls back explicitly; required stops on ASR failure.
# Install pip install -e '.[alignment]' first. Model downloads on first use.
STUDY_WORD_TIMING=auto
STUDY_WHISPER_MODEL=base
